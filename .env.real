# Read only by `vite --mode real`, which `npm run dev:real` runs. Each app's install then starts from the books in the folder
# KUNA_REAL_BOOKS_DIR names, which the dev server serves read-only. The seeds also sit behind `import.meta.env.DEV`, so even a
# build in this mode leaves them out. `scripts/assert-no-fake-bytes.mjs` checks that on every production build.
VITE_REAL_BOOKS=true
